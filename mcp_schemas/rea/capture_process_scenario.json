{
  "name": "capture_process_scenario",
  "description": "Run one caller-selected command under a PTY and return process capture Evidence with residual unknowns. The renderer admits at most 1,000,000 combined terminal cells, computed as columns \u00d7 (rows + scrollback); every resize uses the selected scrollback and must fit the same budget. Supply a smaller terminal shape when that product is too large; dimensions are never clamped. A command name resolves through the inherited PATH; the working directory defaults to the caller's current directory; host environment variables are inherited with scenario overrides. Environment keys cannot contain '=' or NUL, and REA_PROCESS_RUN_ID is reserved for process ownership. Filesystem snapshots are opt-in through filesystem_observation_paths. A positive finalization_ms makes a timeout or idle deadline send SIGTERM to the captured root through its start identity, keep observing, and send SIGKILL once after the interval; exit.finalization records each attempt with its delivery result and the observed exit, and cancellation still ends the run at once. The target runs with the current user's permissions; this is not a security sandbox.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "executable": {
        "$ref": "#/$defs/__schema0",
        "description": "Command name or executable path to run."
      },
      "arguments": {
        "$ref": "#/$defs/__schema2"
      },
      "working_directory": {
        "$ref": "#/$defs/__schema3"
      },
      "environment": {
        "$ref": "#/$defs/__schema4"
      },
      "filesystem_observation_paths": {
        "$ref": "#/$defs/__schema5"
      },
      "terminal": {
        "$ref": "#/$defs/__schema6",
        "description": "The visible terminal and scrollback together must use at most 1,000,000 xterm renderer cells: columns \u00d7 (rows + scrollback). Resize events use the same scrollback and limit."
      },
      "events": {
        "$ref": "#/$defs/__schema10"
      },
      "timeout_ms": {
        "$ref": "#/$defs/__schema12"
      },
      "idle_timeout_ms": {
        "$ref": "#/$defs/__schema14"
      },
      "settle_ms": {
        "$ref": "#/$defs/__schema15"
      },
      "finalization_ms": {
        "$ref": "#/$defs/__schema16",
        "description": "Milliseconds a target may keep running after SIGTERM when timeout_ms or idle_timeout_ms fires, before SIGKILL; 0 sends SIGKILL immediately. Both signals reach the captured root only while its launch-time start identity still matches; cancellation ends the run at once."
      },
      "limits": {
        "$ref": "#/$defs/__schema18",
        "description": "Resource budgets that bound execution and retained output for this operation."
      },
      "normalization": {
        "$ref": "#/$defs/__schema19"
      }
    },
    "required": [
      "executable"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "minLength": 1,
        "$ref": "#/$defs/__schema1"
      },
      "__schema1": {
        "type": "string",
        "pattern": "^[^\\x00]*$"
      },
      "__schema2": {
        "default": [],
        "type": "array",
        "items": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "__schema3": {
