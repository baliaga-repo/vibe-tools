{
  "name": "trace_native_values",
  "description": "Trace a bounded static dependency graph from one explicit native procedure. Includes high-p-code def-use, constants, operators, memory and branch operations, resolved call edges, and derived argument/parameter and return/output bindings. Missing bindings, alias semantics, persistent state and RNG roles remain unknown. Budgets bound depth, decompilations, graph size and payloads; nodes are paginated.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "procedure": {
        "$ref": "#/$defs/__schema0"
      },
      "max_depth": {
        "$ref": "#/$defs/__schema1",
        "description": "Maximum permitted depth for this operation."
      },
      "max_functions": {
        "$ref": "#/$defs/__schema2",
        "description": "Maximum permitted functions for this operation."
      },
      "max_call_sites": {
        "$ref": "#/$defs/__schema3",
        "description": "Maximum permitted call sites for this operation."
      },
      "max_nodes": {
        "$ref": "#/$defs/__schema4",
        "description": "Maximum permitted nodes for this operation."
      },
      "max_edges": {
        "$ref": "#/$defs/__schema5",
        "description": "Maximum permitted edges for this operation."
      },
      "offset": {
        "$ref": "#/$defs/__schema6"
      },
      "limit": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "required": [
      "procedure"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "minLength": 1
      },
      "__schema1": {
        "default": 3,
        "type": "integer",
        "minimum": 0,
        "maximum": 16
      },
      "__schema2": {
        "default": 16,
        "type": "integer",
        "minimum": 1,
        "maximum": 64
      },
      "__schema3": {
        "default": 256,
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "__schema4": {
        "default": 5000,
        "type": "integer",
        "minimum": 1,
        "maximum": 20000
      },
      "__schema5": {
        "default": 10000,
        "type": "integer",
        "minimum": 1,
        "maximum": 40000
      },
      "__schema6": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "__schema7": {
        "default": 1000,
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      }
    },
    "examples": [
      {
        "procedure": "0x1000",
        "max_depth": 3,
        "max_functions": 16,
        "max_call_sites": 256,
        "max_nodes": 5000,
        "max_edges": 10000,
        "offset": 0,
        "limit": 1000
      }
    ]
  }
}