{
  "name": "stop_adb_app",
  "description": "Force-stop every process of one package (`am force-stop`), ending a dynamic-analysis run. A device-mutating tool; it succeeds whether or not the package had running processes.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "serial": {
        "$ref": "#/$defs/__schema0",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "package": {
        "$ref": "#/$defs/__schema1",
        "description": "Package whose processes are force-stopped"
      }
    },
    "required": [
      "serial",
      "package"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\x00\\s\"']+$",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "__schema1": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$",
        "description": "Package whose processes are force-stopped"
      }
    },
    "examples": [
      {
        "serial": "emulator-5554",
        "package": "com.example.app"
      }
    ]
  }
}