{
  "name": "inspect_asset_catalog",
  "description": "Inspect compiled Assets.car metadata in an active Apple app bundle. Returns stable paginated catalog and rendition records with raw assetutil metadata and catalog digests; rendition bytes are not extracted.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "offset": {
        "$ref": "#/$defs/__schema0"
      },
      "limit": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "__schema1": {
        "default": 1000,
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    },
    "examples": [
      {
        "offset": 0,
        "limit": 1000
      }
    ]
  }
}