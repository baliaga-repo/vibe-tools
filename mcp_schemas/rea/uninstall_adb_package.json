{
  "name": "uninstall_adb_package",
  "description": "Uninstall one package from the device (`adb uninstall`), removing its data for user 0. A device-mutating tool; absent packages report the device's own refusal reason.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "serial": {
        "$ref": "#/$defs/__schema0",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "package": {
        "$ref": "#/$defs/__schema1",
        "description": "Installed package to uninstall"
      }
    },
    "required": [
      "serial",
      "package"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\x00\\s\"']+$",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "__schema1": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$",
        "description": "Installed package to uninstall"
      }
    },
    "examples": [
      {
        "serial": "emulator-5554",
        "package": "com.example.app"
      }
    ]
  }
}