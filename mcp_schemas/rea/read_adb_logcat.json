{
  "name": "read_adb_logcat",
  "description": "Read a bounded dump of the device log (`logcat -d -t`) for one buffer, optionally restricted to a process id. No streaming, no clearing; the newest lines are kept when the count cap trims. Read-only.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "serial": {
        "$ref": "#/$defs/__schema0",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "count": {
        "$ref": "#/$defs/__schema1",
        "description": "Number of most recent lines to read (logcat -d -t)"
      },
      "buffer": {
        "$ref": "#/$defs/__schema3",
        "description": "Log buffer to read (logcat -b)"
      },
      "pid": {
        "$ref": "#/$defs/__schema5",
        "description": "Restrict to one process id (logcat --pid)"
      }
    },
    "required": [
      "serial"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\x00\\s\"']+$",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "__schema1": {
        "default": 500,
        "description": "Number of most recent lines to read (logcat -d -t)",
        "$ref": "#/$defs/__schema2"
      },
      "__schema2": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "__schema3": {
        "default": "main",
        "description": "Log buffer to read (logcat -b)",
        "$ref": "#/$defs/__schema4"
      },
      "__schema4": {
        "type": "string",
        "enum": [
          "main",
          "system",
          "radio",
          "events",
          "crash"
        ]
      },
      "__schema5": {
        "description": "Restrict to one process id (logcat --pid)",
        "$ref": "#/$defs/__schema6"
      },
      "__schema6": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "examples": [
      {
        "serial": "emulator-5554",
        "count": 200,
        "buffer": "main"
      }
    ]
  }
}