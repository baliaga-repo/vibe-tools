{
  "name": "read_adb_setting",
  "description": "Read one settings value (`settings get`) from the system, secure, or global namespace. Absent keys report the device's own null observation. Read-only; writing settings is not exposed.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "serial": {
        "$ref": "#/$defs/__schema0",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "namespace": {
        "$ref": "#/$defs/__schema1",
        "description": "Settings namespace to read"
      },
      "key": {
        "$ref": "#/$defs/__schema2",
        "description": "Setting key to read"
      }
    },
    "required": [
      "serial",
      "namespace",
      "key"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\x00\\s\"']+$",
        "description": "Device serial exactly as `adb devices` reports it"
      },
      "__schema1": {
        "type": "string",
        "enum": [
          "system",
          "secure",
          "global"
        ],
        "description": "Settings namespace to read"
      },
      "__schema2": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._\\x2d]+$",
        "description": "Setting key to read"
      }
    },
    "examples": [
      {
        "serial": "emulator-5554",
        "namespace": "secure",
        "key": "adb_enabled"
      }
    ]
  }
}