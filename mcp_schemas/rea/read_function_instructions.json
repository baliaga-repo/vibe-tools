{
  "name": "read_function_instructions",
  "description": "Return every raw instruction for one analyzed procedure. Instruction text and body extent are provider-specific. Ghidra terminal-call assumptions that may cut the analyzed body are reported in limitations.",
  "parameters": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "procedure": {
        "$ref": "#/$defs/__schema0",
        "description": "The procedure name or address"
      },
      "document": {
        "$ref": "#/$defs/__schema1",
        "description": "The document name"
      }
    },
    "required": [
      "procedure"
    ],
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "type": "string",
        "description": "The procedure name or address"
      },
      "__schema1": {
        "description": "The document name",
        "$ref": "#/$defs/__schema2"
      },
      "__schema2": {
        "type": "string"
      }
    },
    "examples": [
      {
        "procedure": "main"
      }
    ]
  }
}